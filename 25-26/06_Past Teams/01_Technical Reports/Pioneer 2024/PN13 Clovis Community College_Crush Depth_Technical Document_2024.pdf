<<
/Type /StructElem
/S /Figure
/P 229 0 R
/Pg 9 0 R
/K [0]
>>
endobj
329 0 obj
<<
/Type /StructElem
/S /P
/ActualText (Figure 1. Crush Depth team photo taken by Bishop Hockman )
/Pg 9 0 R
/K [3]
>>
endobj
